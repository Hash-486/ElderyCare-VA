import os
import json
import gzip
import torch
import whisper
import pandas as pd
from transformers import pipeline
from sentence_transformers import SentenceTransformer, util
from datetime import datetime

# ============================================================
# CONFIG
# ============================================================

config = {
    "stt": {
        "model": "base",
        "device": "cuda" if torch.cuda.is_available() else "cpu"
    },
    "ner": {
        "model": "d4data/biomedical-ner-all",
        "confidence_threshold": 0.60
    },
    "nel": {
        "similarity_threshold": 0.65
    },
    "risk_thresholds": {
        "high": {"count_24h": 2, "hours": 1},
        "moderate": {"count_24h": 1, "hours": 6}
    }
}

# ============================================================
# STT MODULE
# ============================================================

class VoiceToTextPipeline:
    def __init__(self, config):
        self.model = whisper.load_model(
            config["stt"]["model"],
            device=config["stt"]["device"]
        )

    def transcribe(self, audio_path):
        result = self.model.transcribe(
            audio_path,
            language="en",
            fp16=False,
            verbose=False
        )
        return result["text"].strip()

# ============================================================
# NER MODULE
# ============================================================

class ClinicalNER:
    def __init__(self, config):
        self.threshold = config["ner"]["confidence_threshold"]
        self.ner = pipeline(
            "ner",
            model=config["ner"]["model"],
            tokenizer=config["ner"]["model"],
            aggregation_strategy="simple"
        )

    def extract(self, text):
        raw = self.ner(text)
        return [
            {
                "text": r["word"],
                "label": r["entity_group"],
                "confidence": round(float(r["score"]), 3)
            }
            for r in raw if r["score"] >= self.threshold
        ]

# ============================================================
# HPO LOOKUP BUILDER
# ============================================================

def build_hpo_lookup(hpo_path, output_csv):
    if hpo_path.endswith(".gz"):
        with gzip.open(hpo_path, "rt", encoding="utf-8") as f:
            data = json.load(f)
    else:
        with open(hpo_path, "r", encoding="utf-8") as f:
            data = json.load(f)

    rows = []
    for graph in data.get("graphs", []):
        for node in graph.get("nodes", []):
            raw_id = node.get("id", "")
            if "HP_" not in raw_id:
                continue

            hp_id = "HP:" + raw_id.split("HP_")[-1]
            label = node.get("lbl")

            if label:
                rows.append({"hp_id": hp_id, "term": label.lower()})

            for syn in node.get("meta", {}).get("synonyms", []):
                val = syn.get("val")
                if val:
                    rows.append({"hp_id": hp_id, "term": val.lower()})

    pd.DataFrame(rows).drop_duplicates().to_csv(output_csv, index=False)
    print("✅ HPO lookup created")

# ============================================================
# HPO NEL MODULE
# ============================================================

class HPONEL:
    def __init__(self, lookup_csv, threshold):
        self.df = pd.read_csv(lookup_csv)
        self.encoder = SentenceTransformer("all-MiniLM-L6-v2")
        self.threshold = threshold

        self.embeddings = self.encoder.encode(
            self.df["term"].tolist(),
            convert_to_tensor=True,
            show_progress_bar=True
        )

    def link(self, mention):
        q = self.encoder.encode(mention.lower(), convert_to_tensor=True)
        scores = util.cos_sim(q, self.embeddings)[0]
        idx = scores.argmax().item()
        score = scores[idx].item()

        if score < self.threshold:
            return None

        return {
            "hp_id": self.df.iloc[idx]["hp_id"],
            "concept": self.df.iloc[idx]["term"],
            "confidence": round(score, 3)
        }

# ============================================================
# EVENT CREATION
# ============================================================

HPO_ELIGIBLE_LABELS = {"Sign_symptom", "Disease_disorder"}

def create_events(hpo_links, patient_id):
    timestamp = datetime.now().isoformat()
    return [
        {
            "timestamp": timestamp,
            "patient_id": patient_id,
            "hp_id": link["hp_id"],
            "concept": link["concept"],
            "confidence": link["confidence"],
            "source": "voice"
        }
        for link in hpo_links
    ]

# ============================================================
# TEMPORAL FEATURES
# ============================================================

def extract_temporal_features(event_log):
    df = pd.DataFrame(event_log)
    if df.empty:
        return pd.DataFrame()

    df["timestamp"] = pd.to_datetime(df["timestamp"])
    now = pd.Timestamp.now()

    freq = df.groupby(["patient_id", "hp_id"]).size().reset_index(name="total_count")
    last_seen = df.groupby(["patient_id", "hp_id"])["timestamp"].max().reset_index(name="last_seen")
    last_seen["time_since_last_hours"] = (now - last_seen["last_seen"]).dt.total_seconds() / 3600

    recent = df[df["timestamp"] >= now - pd.Timedelta(hours=24)]
    count_24h = recent.groupby(["patient_id", "hp_id"]).size().reset_index(name="count_24h")

    features = freq.merge(last_seen, on=["patient_id", "hp_id"], how="left")
    features = features.merge(count_24h, on=["patient_id", "hp_id"], how="left")
    features["count_24h"] = features["count_24h"].fillna(0).astype(int)

    return features

# ============================================================
# TEMPORAL RISK DECISION
# ============================================================

def temporal_risk_decision(features, thresholds):
    if features.empty:
        return features

    def decide(row):
        if row["count_24h"] >= thresholds["high"]["count_24h"] and row["time_since_last_hours"] <= thresholds["high"]["hours"]:
            return "HIGH"
        elif row["count_24h"] >= thresholds["moderate"]["count_24h"] and row["time_since_last_hours"] <= thresholds["moderate"]["hours"]:
            return "MODERATE"
        else:
            return "LOW"

    features["risk_level"] = features.apply(decide, axis=1)
    return features

# ============================================================
# FULL PIPELINE WITH RISK TRAJECTORY
# ============================================================

class ElderlyCarePipeline:
    def __init__(self, config, hpo_lookup_csv):
        self.stt = VoiceToTextPipeline(config)
        self.ner = ClinicalNER(config)
        self.nel = HPONEL(hpo_lookup_csv, config["nel"]["similarity_threshold"])
        self.event_log = []
        self.risk_log = []   # ⭐ NEW

    def run(self, audio_path, patient_id="P001"):
        text = self.stt.transcribe(audio_path)
        entities = self.ner.extract(text)

        hpo_links = []
        for e in entities:
            if e["label"] in HPO_ELIGIBLE_LABELS:
                link = self.nel.link(e["text"])
                if link:
                    hpo_links.append(link)

        events = create_events(hpo_links, patient_id)
        self.event_log.extend(events)

        features = extract_temporal_features(self.event_log)
        risks = temporal_risk_decision(features, config["risk_thresholds"])

        timestamp = datetime.now().isoformat()
        for _, r in risks.iterrows():
            self.risk_log.append({
                "timestamp": timestamp,
                "patient_id": r["patient_id"],
                "hp_id": r["hp_id"],
                "risk_level": r["risk_level"]
            })

        return risks

